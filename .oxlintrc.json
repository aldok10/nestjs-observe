{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/require-await": "warn",
    "typescript/promise-function-async": "off",
    "typescript/no-base-to-string": "warn",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/no-unsafe-class-instance-assignment": "warn",
    "typescript/unbound-method": "off",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-extraneous-class": "off",

    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "error",
    "no-eval": "error",
    "no-debugger": "error",
    "no-param-reassign": ["error", { "props": false }],

    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "warn",
    "import/no-unassigned-import": ["error", { "allow": ["reflect-metadata"] }],

    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/no-new-statics": "error",
    "promise/valid-params": "error",

    "node/no-process-env": "off",

    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-new-array": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/consistent-function-scoping": "off",

    "vitest/no-conditional-expect": "warn",
    "vitest/require-mock-type-parameters": "warn",

    "oxc/no-accumulating-spread": "warn"
  },
  "overrides": [
    {
      "files": [
        "packages/*/*/src/**/*.spec.ts",
        "packages/*/*/*/src/**/*.spec.ts",
        "packages/core/src/**/*.spec.ts",
        "tests/**/*.ts",
        "tests/**/*.mjs",
        "**/*.test.ts"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-class-instance-assignment": "off",
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-conversion": "off",
        "typescript/require-await": "off",
        "typescript/unbound-method": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "no-console": "off",
        "no-param-reassign": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "packages/logs/logger/src/**/*.ts",
        "packages/traces/tracing/src/**/*.ts",
        "packages/metrics/metrics/src/**/*.ts",
        "packages/observer/observer/src/**/*.ts"
      ],
      "rules": {
        "typescript/no-extraneous-class": "off"
      }
    },
    {
      "files": ["benchmarks/**", "examples/**", "scripts/**"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-class-instance-assignment": "off",
        "node/no-process-env": "off",
        "import/no-unassigned-import": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "**/dist/**",
    "node_modules/**",
    "**/node_modules/**",
    "coverage/**",
    "**/*.d.ts"
  ]
}
