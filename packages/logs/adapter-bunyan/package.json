{
  "name": "@aldok10/nestjs-observe-logger-adapter-bunyan",
  "version": "0.1.0",
  "description": "Independent Bunyan backend adapter for @aldok10/nestjs-observe-logger",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --out-dir dist",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@aldok10/nestjs-observe-logger-core": "^0.1.0"
  },
  "peerDependencies": {
    "bunyan": "^1.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldok10/nestjs-observe.git",
    "directory": "packages/logs/adapter-bunyan"
  },
  "homepage": "https://github.com/aldok10/nestjs-observe#readme",
  "bugs": {
    "url": "https://github.com/aldok10/nestjs-observe/issues"
  },
  "author": "aldok10",
  "keywords": [
    "nestjs",
    "logger",
    "logging",
    "typescript"
  ],
  "sideEffects": false
}
