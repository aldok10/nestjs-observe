{
  "name": "@aldok10/nestjs-observe-logger-http",
  "version": "0.1.1",
  "description": "Independent Express and Fastify HTTP request logging integration for @aldok10/nestjs-observe-logger",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "import": "./dist/nestjs.js",
      "require": "./dist/nestjs.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/nestjs.ts --format esm,cjs --shims --dts --clean --out-dir dist",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@aldok10/nestjs-observe-logger-core": "^0.1.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldok10/nestjs-observe.git",
    "directory": "packages/logs/integration-http"
  },
  "homepage": "https://github.com/aldok10/nestjs-observe#readme",
  "bugs": {
    "url": "https://github.com/aldok10/nestjs-observe/issues"
  },
  "author": "aldok10",
  "keywords": [
    "nestjs",
    "logger",
    "logging",
    "typescript"
  ],
  "sideEffects": false
}
