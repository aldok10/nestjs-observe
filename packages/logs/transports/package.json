{
  "name": "@aldok10/nestjs-observe-logger-transports",
  "version": "0.1.1",
  "description": "Consolidated log transports (Console, File/Rotating Stream, HTTP, Elasticsearch, OpenObserve, Loki, OTLP) for @aldok10/nestjs-observe-logger",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/console.js",
      "require": "./dist/console.cjs"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js",
      "require": "./dist/file.cjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "require": "./dist/http.cjs"
    },
    "./elasticsearch": {
      "types": "./dist/elasticsearch.d.ts",
      "import": "./dist/elasticsearch.js",
      "require": "./dist/elasticsearch.cjs"
    },
    "./openobserve": {
      "types": "./dist/openobserve.d.ts",
      "import": "./dist/openobserve.js",
      "require": "./dist/openobserve.cjs"
    },
    "./loki": {
      "types": "./dist/loki.d.ts",
      "import": "./dist/loki.js",
      "require": "./dist/loki.cjs"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "import": "./dist/otlp.js",
      "require": "./dist/otlp.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/console.ts src/file.ts src/http.ts src/elasticsearch.ts src/openobserve.ts src/loki.ts src/otlp.ts --format esm,cjs --splitting --shims --dts --clean --out-dir dist",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@aldok10/nestjs-observe-logger-core": "^0.1.1",
    "@aldok10/nestjs-observe-logger-delivery": "^0.1.1",
    "@aldok10/nestjs-observe-logger-formatters": "^0.1.1"
  },
  "peerDependencies": {
    "rotating-file-stream": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "rotating-file-stream": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "rotating-file-stream": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldok10/nestjs-observe.git",
    "directory": "packages/logs/transports"
  },
  "author": "aldok10",
  "keywords": [
    "nestjs",
    "logger",
    "transports",
    "console",
    "file",
    "http",
    "elasticsearch",
    "openobserve",
    "loki",
    "otlp",
    "typescript"
  ],
  "sideEffects": false
}
