{
  "name": "@aldok10/nestjs-observe-testing",
  "version": "0.1.1",
  "description": "Unified observability test harness composing Logger, Tracing, and Metrics test doubles",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --out-dir dist",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@aldok10/nestjs-observe": "^0.1.1",
    "@aldok10/nestjs-observe-core": "^0.1.1",
    "@aldok10/nestjs-observe-logger-testing": "^0.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1"
  },
  "devDependencies": {
    "@aldok10/nestjs-observe-logger": "^0.1.1",
    "@aldok10/nestjs-observe-logger-testing": "^0.1.1",
    "@aldok10/nestjs-observe-metrics": "^0.1.1",
    "@aldok10/nestjs-observe-metrics-testing": "^0.1.1",
    "@aldok10/nestjs-observe-tracing": "^0.1.1",
    "@aldok10/nestjs-observe-tracing-testing": "^0.1.1"
  },
  "peerDependencies": {
    "@aldok10/nestjs-observe-logger": "^0.1.1",
    "@aldok10/nestjs-observe-logger-testing": "^0.1.1",
    "@aldok10/nestjs-observe-metrics": "^0.1.1",
    "@aldok10/nestjs-observe-metrics-testing": "^0.1.1",
    "@aldok10/nestjs-observe-tracing": "^0.1.1",
    "@aldok10/nestjs-observe-tracing-testing": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@aldok10/nestjs-observe-logger": {
      "optional": true
    },
    "@aldok10/nestjs-observe-logger-testing": {
      "optional": true
    },
    "@aldok10/nestjs-observe-metrics": {
      "optional": true
    },
    "@aldok10/nestjs-observe-metrics-testing": {
      "optional": true
    },
    "@aldok10/nestjs-observe-tracing": {
      "optional": true
    },
    "@aldok10/nestjs-observe-tracing-testing": {
      "optional": true
    }
  },
  "sideEffects": false
}
