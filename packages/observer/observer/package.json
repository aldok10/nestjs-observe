{
  "name": "@aldok10/nestjs-observe",
  "version": "0.1.1",
  "description": "Unified NestJS observability integration composing standalone Logger, Tracing, and Metrics packages",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --shims --dts --clean --out-dir dist",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@aldok10/nestjs-observe-core": "^0.1.1"
  },
  "devDependencies": {
    "@aldok10/nestjs-observe-error-tracking": "^0.1.1",
    "@aldok10/nestjs-observe-logger": "^0.1.1",
    "@aldok10/nestjs-observe-logger-testing": "^0.1.1",
    "@aldok10/nestjs-observe-metrics": "^0.1.1",
    "@aldok10/nestjs-observe-tracing": "^0.1.1"
  },
  "peerDependencies": {
    "@aldok10/nestjs-observe-error-tracking": "^0.1.1",
    "@aldok10/nestjs-observe-logger": "^0.1.1",
    "@aldok10/nestjs-observe-metrics": "^0.1.1",
    "@aldok10/nestjs-observe-tracing": "^0.1.1",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@aldok10/nestjs-observe-error-tracking": {
      "optional": true
    },
    "@aldok10/nestjs-observe-logger": {
      "optional": true
    },
    "@aldok10/nestjs-observe-metrics": {
      "optional": true
    },
    "@aldok10/nestjs-observe-tracing": {
      "optional": true
    }
  },
  "sideEffects": false
}
