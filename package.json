    "@aldok10/nestjs-observe-error-tracking-otlp": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-raygun": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-rollbar": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-sentry": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-splunk": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-testing": "workspace:*",
    "@aldok10/nestjs-observe-logger": "workspace:*",
