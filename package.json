    "@aldok10/nestjs-observe-logger-testing": "workspace:*",
    "@aldok10/nestjs-observe-logger-transports": "workspace:*",
    "@aldok10/nestjs-observe-metrics": "workspace:*",
    "@aldok10/nestjs-observe-metrics-exporter-console": "workspace:*",
