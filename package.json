{
  "name": "nestjs-observe-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "bench": "node benchmarks/log-throughput.mjs",
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:strict": "oxlint --deny-warnings",
    "lint:ci": "oxlint --deny-warnings",
    "lint:arch": "node scripts/check-architecture.mjs",
    "arch:check": "node scripts/check-architecture.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "test:consumer": "node scripts/test-consumer-install.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "version:bump": "node scripts/bump-version.mjs",
    "publish:dry-run": "pnpm -r --filter './packages/**' publish --dry-run --access public --no-git-checks",
    "publish:packages": "pnpm -r --no-bail --filter './packages/**' exec pnpm publish --access public --no-git-checks",
    "publish:packages:github": "pnpm -r --no-bail --filter './packages/**' exec pnpm publish --access public --no-git-checks --registry https://npm.pkg.github.com",
    "publish:check-versions": "node scripts/check-publish-versions.mjs",
    "publish:packages:only-new": "node scripts/check-publish-versions.mjs --publish",
    "test:coverage": "vitest run --coverage",
    "pack:dry-run": "pnpm -r --filter './packages/**' exec npm pack --dry-run",
    "release": "pnpm build && pnpm test && pnpm run lint && pnpm run typecheck && pnpm changeset publish"
  },
  "devDependencies": {
    "@aldok10/nestjs-observe": "workspace:*",
    "@aldok10/nestjs-observe-core": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-airbrake": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-appdynamics": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-bugsink": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-bugsnag": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-datadog": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-dynatrace": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-elastic-apm": "workspace:*",
    "@aldok10/nestjs-observe-error-tracking-glitchtip": "workspace:*",
