    "@aldok10/nestjs-observe-logger-adapter-log4js": "workspace:*",
    "@aldok10/nestjs-observe-logger-adapter-pino": "workspace:*",
    "@aldok10/nestjs-observe-logger-adapter-winston": "workspace:*",
