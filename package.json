    "@aldok10/nestjs-observe-tracing-testing": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/testing": "^12.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-prometheus": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.1.2",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "pino": "^10.4.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^4.0.0",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
